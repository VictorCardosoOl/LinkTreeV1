{
  "name": "linktreev1",
  "version": "1.3.1",
  "type": "module",
  "description": "Página pessoal de links do Victor Cardoso — animações baseadas em física, UI com efeito vidro (glassmorphism), pronto para PWA.",
  "main": "script.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js,.ts",
    "lint:fix": "eslint src/ --ext .js,.ts --fix",
    "format": "prettier --write \"**/*.{js,ts,html,css,json,md}\"",
    "check": "eslint src/ --ext .js,.ts ; prettier --check \"**/*.{js,ts,html,css,json,md}\"",
    "test": "vitest run"
  },
  "keywords": [
    "portfolio",
    "linktree",
    "gsap",
    "vite",
    "glassmorphism"
  ],
  "author": "Victor Cardoso <victorcardcunha@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^26.3.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "vite": "^7.3.4",
    "vite-plugin-handlebars": "^2.0.3",
    "vitest": "^4.1.11"
  }
}
